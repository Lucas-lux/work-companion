{
  "manifest_version": 3,
  "name": "Work Companion",
  "version": "0.1.0",
  "description": "Permet à ton chat Work Companion de voir l'onglet actif et de fermer les distractions.",
  "permissions": ["tabs", "alarms"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "work-companion@local", "strict_min_version": "121.0" }
  }
}
